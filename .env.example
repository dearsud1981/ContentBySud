# Which text provider to use: gemini (default) | groq | offline
# If the selected provider's key is missing or the call fails, the app
# automatically falls back to offline template mode and shows a notice.
LLM_PROVIDER=gemini

# Google Gemini free tier — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=
# Optional model override (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
